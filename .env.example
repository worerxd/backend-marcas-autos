# Valores solo para desarrollo local.
# Copia este archivo a .env antes de ejecutar docker compose.
# No reutilices esta contraseña fuera de este entorno.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=MarcasAutosDb

# Para ejecutar la API en el host, fuera de Docker:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=MarcasAutosDb;Username=postgres;Password=postgres123
